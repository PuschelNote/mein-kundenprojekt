generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rolle {
  bedienung
  manager
  inhaber
}

enum Wochentag {
  montag
  dienstag
  mittwoch
  donnerstag
  freitag
  samstag
  sonntag
}

enum TischStatus {
  frei
  besetzt
  reserviert
}

enum TischBereich {
  innen
  terrasse
}

enum ReservierungStatus {
  offen
  storniert
}

enum GerichtKategorie {
  antipasti
  pasta
  risotto
  dessert
  getraenke
  grill
}

model Standort {
  id                       String                    @id
  name                     String                    @unique
  mitarbeiter              Mitarbeiter[]
  standardOeffnungszeiten StandardOeffnungszeit[]
  tische                   Tisch[]
  reservierungen           Reservierung[]
  gerichte                 Gericht[]
}

model StandardOeffnungszeit {
  id              String     @id @default(cuid())
  standortId      String
  standort        Standort   @relation(fields: [standortId], references: [id], onDelete: Cascade)
  wochentag       Wochentag
  oeffnetMinute   Int
  schliesstMinute Int

  @@unique([standortId, wochentag])
  @@index([standortId])
}

model Mitarbeiter {
  id         String   @id @default(cuid())
  name       String
  rolle      Rolle
  standortId String
  standort   Standort @relation(fields: [standortId], references: [id], onDelete: Restrict)
  erstelltAm DateTime @default(now())
  geaendertAm DateTime @updatedAt
  erstellteReservierungen  Reservierung[] @relation("ReservierungErsteller")
  geaenderteReservierungen Reservierung[] @relation("ReservierungBearbeiter")

  @@index([standortId])
  @@index([rolle])
}

model Gast {
  id                    String   @id @default(cuid())
  name                  String
  telefon               String
  telefonNormalisiert   String   @unique
  besuchszaehler        Int      @default(0)
  notizen               String?
  erstelltAm            DateTime @default(now())
  geaendertAm           DateTime @updatedAt
  reservierungen        Reservierung[]

  @@index([name])
}

model Tisch {
  id            String          @id
  nummer        Int
  kapazitaet    Int
  status        TischStatus     @default(frei)
  bereich       TischBereich
  verfuegbar    Boolean         @default(true)
  rasterZeile   Int
  rasterSpalte  Int
  vorlaeufig    Boolean         @default(true)
  standortId    String
  standort      Standort        @relation(fields: [standortId], references: [id], onDelete: Restrict)
  reservierungen Reservierung[]

  @@unique([standortId, nummer])
  @@unique([standortId, rasterZeile, rasterSpalte])
  @@index([standortId])
}

model Reservierung {
  id              String              @id
  datum           String
  uhrzeitMinute   Int
  personenzahl    Int
  status          ReservierungStatus  @default(offen)
  standortId      String
  standort        Standort            @relation(fields: [standortId], references: [id], onDelete: Restrict)
  tischId         String
  tisch           Tisch               @relation(fields: [tischId], references: [id], onDelete: Restrict)
  gastId          String
  gast            Gast                @relation(fields: [gastId], references: [id], onDelete: Restrict)
  erstelltVonId   String
  erstelltVon     Mitarbeiter         @relation("ReservierungErsteller", fields: [erstelltVonId], references: [id], onDelete: Restrict)
  geaendertVonId  String?
  geaendertVon    Mitarbeiter?        @relation("ReservierungBearbeiter", fields: [geaendertVonId], references: [id], onDelete: Restrict)
  erstelltAm      DateTime            @default(now())
  geaendertAm     DateTime            @updatedAt

  @@index([standortId, datum, uhrzeitMinute])
  @@index([tischId])
  @@index([gastId])
  @@index([erstelltVonId])
  @@index([geaendertVonId])
}

model Gericht {
  id               String           @id
  name             String
  nameNormalisiert String
  beschreibung     String
  preisCent        Int
  kategorie        GerichtKategorie
  istTagesgericht  Boolean          @default(false)
  istSaisongericht Boolean          @default(false)
  standortId       String
  standort         Standort         @relation(fields: [standortId], references: [id], onDelete: Restrict)
  erstelltAm       DateTime         @default(now())
  geaendertAm      DateTime         @updatedAt

  @@unique([standortId, nameNormalisiert])
  @@index([standortId, kategorie])
}
