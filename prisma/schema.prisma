generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rolle {
  bedienung
  manager
  inhaber
}

enum Wochentag {
  montag
  dienstag
  mittwoch
  donnerstag
  freitag
  samstag
  sonntag
}

model Standort {
  id                       String                    @id
  name                     String                    @unique
  mitarbeiter              Mitarbeiter[]
  standardOeffnungszeiten StandardOeffnungszeit[]
}

model StandardOeffnungszeit {
  id              String     @id @default(cuid())
  standortId      String
  standort        Standort   @relation(fields: [standortId], references: [id], onDelete: Cascade)
  wochentag       Wochentag
  oeffnetMinute   Int
  schliesstMinute Int

  @@unique([standortId, wochentag])
  @@index([standortId])
}

model Mitarbeiter {
  id         String   @id @default(cuid())
  name       String
  rolle      Rolle
  standortId String
  standort   Standort @relation(fields: [standortId], references: [id], onDelete: Restrict)
  erstelltAm DateTime @default(now())
  geaendertAm DateTime @updatedAt

  @@index([standortId])
  @@index([rolle])
}
